@model Notely.Models.Note

<div class="container mt-5">
    <div class="card shadow p-4 mx-auto" style="max-width:600px">

        <h3 class="text-center mb-4">📝 Create New Note</h3>

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger"></div>

          

         
            <div class="mb-3">
                <label class="form-label">Title</label>
                <input asp-for="Title" class="form-control" placeholder="Enter title..." />
            </div>

           
            <div class="mb-3">
                <label class="form-label">Content</label>
                <textarea asp-for="Content" class="form-control" placeholder="Write your note..."></textarea>
            </div>

            
            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="State" />
                <label class="form-check-label">Make Public</label>
            </div>

            <div class="mb-3">
                <label class="form-label">Upload Image</label>

                <input type="file"
                       asp-for="ImageFile"
                       class="form-control"
                       accept="image/*"
                       onchange="previewImage(event)" />
            </div>

            
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">⬅ Back</a>
                <button type="submit" class="btn btn-success">➕ Create</button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <script>
        function previewImage(event) {
            var img = document.getElementById('preview');
            img.src = URL.createObjectURL(event.target.files[0]);
        }
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}