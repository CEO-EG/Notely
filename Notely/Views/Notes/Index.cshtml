@model IEnumerable<Notely.Models.Note>

@{
    ViewData["Title"] = "My Notes";
}

<div class="container mt-page">

    <!-- Page header -->
    <div class="page-header">
        <h2><i class="bi bi-journals me-2" style="color:var(--color-primary)"></i>My Notes</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>New Note
        </a>
    </div>

    <!-- Search -->
    <div class="mb-6 d-flex justify-content-center" style="margin-bottom:var(--space-8);">
        <form method="get" asp-action="Index" class="search-wrapper">
            <i class="bi bi-search search-icon"></i>
            <input type="text"
                   name="search"
                   value="@Context.Request.Query["search"]"
                   class="form-control search-input"
                   placeholder="Search your notes…" />
        </form>
    </div>

    <!-- Notes grid -->
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-journal-x"></i></div>
            <h4>No notes yet</h4>
            <p>Start by creating your first note.</p>
            <a asp-action="Create" class="btn btn-primary mt-2">
                <i class="bi bi-plus-lg me-1"></i>Create Note
            </a>
        </div>
    }
    else
    {
        <div class="notes-grid">
            @foreach (var note in Model)
            {
                <div class="note-card">

                    @if (!string.IsNullOrEmpty(note.ImagePath))
                    {
                        <img src="@note.ImagePath" class="card-img-top" alt="@note.Title" />
                    }

                    <div class="card-body">
                        <h6 class="note-title">@note.Title</h6>
                        <p class="note-excerpt">@note.Content</p>

                        <div class="d-flex align-items-center justify-content-between mt-auto">
                            <span class="note-date">
                                <i class="bi bi-calendar3 me-1"></i>@note.CreatedAt.ToShortDateString()
                            </span>
                            @if (note.State)
                            {
                                <span class="badge bg-success"><i class="bi bi-globe2"></i> Public</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary"><i class="bi bi-lock-fill"></i> Private</span>
                            }
                        </div>
                    </div>

                    <div class="card-footer d-flex justify-content-between align-items-center gap-2">
                        <a asp-action="Edit"    asp-route-id="@note.Id" class="btn btn-sm btn-outline-primary flex-fill text-center">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <a asp-action="Details" asp-route-id="@note.Id" class="btn btn-sm btn-outline-info flex-fill text-center">
                            <i class="bi bi-eye me-1"></i>View
                        </a>
                        <a asp-action="Delete"  asp-route-id="@note.Id" class="btn btn-sm btn-outline-danger flex-fill text-center">
                            <i class="bi bi-trash me-1"></i>Delete
                        </a>
                    </div>

                </div>
            }
        </div>
    }

</div>
