@model IEnumerable<Notely.Models.Note>

@{
    ViewData["Title"] = "My Notes";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

<h2 class="mb-4">My Notes</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Create New Note</a>
</p>

<div class="d-flex justify-content-center mb-4">

    <form method="get" asp-action="Index" style="width:60%; max-width:700px;">

        <div class="position-relative">

           
            <i class="bi bi-search"
               style="position:absolute;
            top:50%;
            left:15px;
            transform:translateY(-50%);
            color:#6c757d;"></i>

            
            <input type="text"
                   name="search"
                   value="@Context.Request.Query["search"]"
                   class="form-control"
                   placeholder="Search your notes..."
                   style="padding-left:40px;
            height:50px;
            border-radius:50px;
            text-align:center;" />

        </div>

    </form>

</div>

<div class="row g-3">

    @foreach (var note in Model)
    {
        <div class="col-md-3 col-lg-4">


            <div class="card shadow-sm h-100 border-0 note-card">

                @if (!string.IsNullOrEmpty(note.ImagePath))
                {
                    <img src="@note.ImagePath"
                         class="card-img-top"
                         style="height:140px;object-fit:cover;" />
                }

                <div class="card-body p-2">

                    <h6 class="fw-bold mb-1">@note.Title</h6>

                    <p class="text-muted small mb-1">
                        @note.Content
                    </p>

                    <small class="text-muted">
                        @note.CreatedAt.ToShortDateString()
                    </small>

                    <div class="mt-2">
                        @if (note.State)
                        {
                            <span class="badge bg-success">Public 🌍</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Private 🔒</span>
                        }
                    </div>

                </div>

                <div class="card-footer bg-white border-0 p-2 d-flex justify-content-between">

                    <a asp-action="Edit" asp-route-id="@note.Id"
                       class="btn btn-sm btn-outline-primary">Edit</a>

                    <a asp-action="Details" asp-route-id="@note.Id"
                       class="btn btn-sm btn-outline-info">Details</a>

                    <a asp-action="Delete" asp-route-id="@note.Id"
                       class="btn btn-sm btn-outline-danger">Delete</a>

                </div>

            </div>

        </div>
    }

</div>
