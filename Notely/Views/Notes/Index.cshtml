@model List<Notely.Models.Note>

<h2>All Notes</h2>

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Content</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var note in Model)
            {
                <tr>
                    <td>@note.Title</td>
                    <td>@note.Content</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="2">No notes found</td>
            </tr>
        }

    </tbody>
</table>
