@model Notely.Models.Note

@{
    ViewData["Title"] = "Delete Note";
}

<div class="container mt-page">
    <div class="form-card text-center" style="max-width:520px;">

        <!-- Warning icon -->
        <div style="width:64px;height:64px;border-radius:var(--border-radius-full);background:rgba(239,68,68,.12);display:flex;align-items:center;justify-content:center;margin:0 auto var(--space-5);font-size:30px;color:var(--color-danger);">
            <i class="bi bi-trash3-fill"></i>
        </div>

        <h3 style="font-weight:800;color:var(--color-danger);" class="mb-2">Delete Note?</h3>
        <p style="color:var(--text-secondary);" class="mb-5">
            This action is <strong>irreversible</strong>. The note will be permanently deleted.
        </p>

        <!-- Note preview -->
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath" class="note-image-preview mb-4 mx-auto d-block" alt="@Model.Title" style="max-width:360px;" />
        }

        <div class="p-4 mb-5 rounded text-start" style="background:var(--bg-muted);border:1px solid var(--border-color);">
            <h6 class="mb-1" style="font-weight:700;">@Model.Title</h6>
            <p class="mb-0" style="font-size:var(--font-size-sm);color:var(--text-secondary);">@Model.Content</p>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-center gap-3">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Cancel
                </a>
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash3 me-1"></i>Yes, Delete
                </button>
            </div>
        </form>

    </div>
</div>