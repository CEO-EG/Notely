@model Notely.Models.Note

<div class="container mt-5">
    <div class="card shadow p-4 mx-auto" style="max-width:600px">

        <h3 class="mb-4 text-center">✏️ Edit Note</h3>

        <form asp-action="Edit" method = "post" enctype="multipart/form-data">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />

            <!-- Image -->
            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <img src="@Model.ImagePath" class="img-fluid rounded mb-3" style="height:200px;object-fit:cover;" />
            }

            <!-- Title -->
            <div class="mb-3">
                <label class="form-label">Title</label>
                <input asp-for="Title" class="form-control" />
            </div>

            <!-- Content -->
            <div class="mb-3">
                <label class="form-label">Content</label>
                <textarea asp-for="Content" class="form-control"></textarea>
            </div>

            <!-- Public -->
            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="State" />
                <label class="form-check-label">Make Public</label>
            </div>

            <!-- Upload new image -->
            <div class="mb-3">
                <label class="form-label">Change Image</label>
                <input type="file" asp-for="ImageFile" class="form-control position-relative" style="z-index:10;" />
            </div>

            <!-- Buttons -->
            <div class="d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">⬅ Back</a>
                <button type="submit" class="btn btn-primary">💾 Save</button>
            </div>

        </form>
    </div>
</div>