@model Notely.Models.Note

@{
    ViewData["Title"] = "Note Details";

  
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    bool isOwner = currentUserId != null &&
                   Model.UserId == int.Parse(currentUserId);
}

<div class="container mt-page">

    <div class="form-card">

        <!-- Header -->
        <div class="d-flex align-items-start justify-content-between gap-3 mb-4">

            <div>

                <h3 class="mb-1 fw-bold">
                    @Model.Title
                </h3>

                <p class="mb-0 text-muted small">

                    <i class="bi bi-calendar3 me-1"></i>

                    @Model.CreatedAt.ToString("dd MMM yyyy")

                </p>

            </div>

            @if (Model.State)
            {
                <span class="badge bg-success flex-shrink-0">
                    <i class="bi bi-globe2 me-1"></i>
                    Public
                </span>
            }
            else
            {
                <span class="badge bg-secondary flex-shrink-0">
                    <i class="bi bi-lock-fill me-1"></i>
                    Private
                </span>
            }

        </div>

        <!-- Image -->
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <div class="mb-4">

                <img src="@Model.ImagePath"
                     class="note-image-preview"
                     alt="@Model.Title" />

            </div>
        }

        <!-- Content -->
        <div class="mb-5 p-4 rounded note-content-box">

            @Model.Content

        </div>

        <!-- Actions -->
        <div class="d-flex justify-content-between align-items-center">

            <a asp-action="Index"
                   class="btn btn-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Back

            </a>

            @if (isOwner)
            {
                <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">

                    <i class="bi bi-pencil me-1"></i>
                    Edit Note

                </a>
            }

        </div>

    </div>

</div>