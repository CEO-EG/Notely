@model Notely.Models.Note

@{
    ViewData["Title"] = "Note Details";
}

<div class="container mt-page">
    <div class="form-card">

        <!-- Header row -->
        <div class="d-flex align-items-start justify-content-between gap-3 mb-4">
            <div>
                <h3 class="mb-1" style="font-weight:800;">@Model.Title</h3>
                <p class="mb-0" style="font-size:var(--font-size-xs);color:var(--text-muted);">
                    <i class="bi bi-calendar3 me-1"></i>@Model.CreatedAt.ToString("dd MMM yyyy")
                </p>
            </div>
            @if (Model.State)
            {
                <span class="badge bg-success" style="flex-shrink:0;"><i class="bi bi-globe2"></i> Public</span>
            }
            else
            {
                <span class="badge bg-secondary" style="flex-shrink:0;"><i class="bi bi-lock-fill"></i> Private</span>
            }
        </div>

        <!-- Image -->
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath" class="note-image-preview mb-4" alt="@Model.Title" />
        }

        <!-- Content -->
        <div class="mb-5 p-4 rounded" style="background:var(--bg-muted);border:1px solid var(--border-color);border-radius:var(--border-radius);color:var(--text-secondary);line-height:var(--line-height-loose);white-space:pre-wrap;">@Model.Content</div>

        <!-- Actions -->
        <div class="d-flex justify-content-between align-items-center gap-3">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back
            </a>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>Edit Note
            </a>
        </div>

    </div>
</div>