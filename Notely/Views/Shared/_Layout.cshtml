@using Microsoft.AspNetCore.Identity
@inject SignInManager<Notely.Models.ApplicationUser> SignInManager
@inject UserManager<Notely.Models.ApplicationUser> UserManager

@{
    var user = await UserManager.GetUserAsync(User);
    var firstName = user?.Fullname?.Split(' ').FirstOrDefault() ?? "User";
    var profileImage = !string.IsNullOrEmpty(user?.ProfileImagepath)
        ? user.ProfileImagepath
        : "/imgs/default.png";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Notely</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-3">
            <div class="container-fluid">

                <!-- LOGO -->
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-journal-bookmark-fill text-primary me-2" style="font-size:24px;"></i>
                    <span class="fw-bold">Notely</span>
                </a>

                <!-- RIGHT SIDE -->
                <div class="collapse navbar-collapse justify-content-end">

                    <ul class="navbar-nav align-items-center">

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle d-flex align-items-center"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">

                                    <!-- PROFILE IMAGE -->
                                    <img src="@profileImage"
                                         class="rounded-circle me-2"
                                         style="width:35px;height:35px;object-fit:cover;" />

                                    <span>@firstName</span>
                                </a>

                                <!-- DROPDOWN -->
                                <ul class="dropdown-menu dropdown-menu-end p-3 text-center shadow-sm">

                                    <li>
                                        <img src="@profileImage"
                                             class="rounded-circle mb-2"
                                             style="width:70px;height:70px;object-fit:cover;" />
                                    </li>

                                    <li>
                                        <h6 class="mb-0">@user?.Fullname</h6>
                                        <small class="text-muted">@user?.Email</small>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <a class="dropdown-item"
                                               asp-controller="Account"
                                               asp-action="Profile">
                                            👤 Profile
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                               asp-controller="Notes"
                                               asp-action="Index">
                                            📒 My Notes
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                🚪 Logout
                                            </button>
                                        </form>
                                    </li>

                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>