@model Notely.Models.RegisterViewModel;

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page" style="align-items:flex-start;padding-top:var(--space-10);">
    <div class="auth-card" style="max-width:480px;">

        <!-- Logo -->
        <div class="auth-logo">
            <i class="bi bi-person-plus-fill"></i>
        </div>

        <h3 class="text-center mb-1" style="font-weight:800;">Create Account</h3>
        <p class="text-center mb-5" style="color:var(--text-muted);font-size:var(--font-size-sm);">
            Join Notely and start organising your thoughts
        </p>

        <form asp-action="Register" method="post" enctype="multipart/form-data" novalidate>
            <div asp-validation-summary="All" class="alert-danger mb-4"></div>

            <!-- Name row -->
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <label asp-for="FirstName" class="form-label">First name</label>
                    <input asp-for="FirstName" class="form-control" placeholder="Jane" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-6">
                    <label asp-for="LastName" class="form-label">Last name</label>
                    <input asp-for="LastName" class="form-control" placeholder="Doe" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <!-- Email -->
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email address</label>
                <div class="position-relative">
                    <i class="bi bi-envelope" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--text-muted);pointer-events:none;"></i>
                    <input asp-for="Email" class="form-control" placeholder="you@example.com"
                           style="padding-left:40px;" autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <!-- Profile image -->
            <div class="mb-3">
                <label class="form-label">Profile image <span style="color:var(--text-muted);font-weight:400;">(optional)</span></label>
                <input type="file" name="ProfileImage" class="form-control" accept="image/*" />
            </div>

            <!-- Password -->
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="position-relative">
                    <i class="bi bi-lock" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--text-muted);pointer-events:none;"></i>
                    <input asp-for="Password" class="form-control" placeholder="••••••••"
                           style="padding-left:40px;" autocomplete="new-password" />
                </div>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <!-- Confirm Password -->
            <div class="mb-5">
                <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                <div class="position-relative">
                    <i class="bi bi-lock-fill" style="position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--text-muted);pointer-events:none;"></i>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••"
                           style="padding-left:40px;" autocomplete="new-password" />
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <!-- Submit -->
            <div class="d-grid mt-1">
            <button type="submit" class="btn btn-primary btn-lg w-100 d-flex justify-content-center align-items-center gap-2">
                <i class="bi bi-person-plus"></i>
                <span>Create Account</span>
            </button>
            </div>

            <!-- Login link -->
            <p class="text-center mb-0" style="font-size:var(--font-size-sm);color:var(--text-muted);">
                Already have an account?
                <a asp-action="Login" style="font-weight:600;">Sign in &rarr;</a>
            </p>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}