@model Notely.Models.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container profile-page">

    <!-- Profile Header -->
    <div class="profile-header-card">

        <img src="@(Model.ProfileImagePath ?? "/imgs/default.jpg")"
             class="profile-avatar-lg"
             alt="@Model.FirstName @Model.LastName" />

        <h3>@Model.FirstName @Model.LastName</h3>

        <p>
            <i class="bi bi-envelope me-1"></i>
            @Model.Email
        </p>

        <div class="profile-stats mt-4">

            <div class="row g-3 text-center">

                <div class="col-4">
                    <div class="stats-card">
                        <h4>@Model.TotalNotes</h4>
                        <p>Total Notes</p>
                    </div>
                </div>

                <div class="col-4">
                    <div class="stats-card">
                        <h4>@Model.PublicNotes</h4>
                        <p>Public Notes</p>
                    </div>
                </div>

                <div class="col-4">
                    <div class="stats-card">
                        <h4>@Model.PrivateNotes</h4>
                        <p>Private Notes</p>
                    </div>
                </div>

            </div>

        </div>

    </div>

    <!-- Profile Form -->
    <div class="row g-5 justify-content-center">

        <div class="col-12 col-lg-7">

            <div class="form-card">

                <h5 class="mb-1 fw-700">Edit Profile</h5>

                <p class="mb-5"
                       style="font-size:var(--font-size-sm);color:var(--text-muted);">
                    Update your display name and profile picture.
                </p>

                <!-- Update Profile Form -->
                <form id="editProfileForm"
                      asp-action="UpdateProfile"
                      method="post"
                      enctype="multipart/form-data"
                      novalidate>

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="All"
                         class="alert-danger mb-4"></div>

                    <!-- Hidden Inputs -->
                    <input type="hidden" asp-for="ProfileImagePath" />
                    <input type="hidden" asp-for="Email" />

                    <!-- First Name -->
                    <div class="mb-4">

                        <label asp-for="FirstName"
                               class="form-label">
                            First Name
                        </label>

                        <div class="position-relative">

                            <i class="bi bi-person"
                                   style="position:absolute;
                                left:14px;
                                top:50%;
                                transform:translateY(-50%);
                                color:var(--text-muted);
                                pointer-events:none;">
                            </i>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   style="padding-left:40px;"
                                   autocomplete="name" />

                        </div>

                        <span asp-validation-for="FirstName"
                              class="text-danger"></span>

                    </div>

                    <!-- Last Name -->
                    <div class="mb-4">

                        <label asp-for="LastName"
                               class="form-label">
                            Last Name
                        </label>

                        <div class="position-relative">

                            <i class="bi bi-person"
                                   style="position:absolute;
                                left:14px;
                                top:50%;
                                transform:translateY(-50%);
                                color:var(--text-muted);
                                pointer-events:none;">
                            </i>

                            <input asp-for="LastName"
                                   class="form-control"
                                   style="padding-left:40px;"
                                   autocomplete="name" />

                        </div>

                        <span asp-validation-for="LastName"
                              class="text-danger"></span>

                    </div>

                    <!-- Profile Image -->
                    <div class="mb-5">

                        <label class="form-label">
                            Profile Picture
                            <span style="color:var(--text-muted);font-weight:400;">
                                (optional — leave blank to keep current)
                            </span>
                        </label>

                        <input type="file"
                               name="ProfileImage"
                               class="form-control"
                               accept="image/*" />

                    </div>

                </form>

                <!-- Buttons -->
                <div class="d-flex justify-content-between mt-4">

                    <!-- Delete Account -->
                    <form asp-action="DeleteAccount" method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-danger"
                                onclick="return confirm('Delete your account permanently?')">

                            <i class="bi bi-trash-fill me-2"></i>
                            Delete Account

                        </button>

                    </form>

                    <!-- Save Changes -->
                    <button type="submit"
                            form="editProfileForm"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle-fill me-2"></i>
                        Save Changes

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}