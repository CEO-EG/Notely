@model Notely.Models.ProfileViewModel

@{
    ViewData["Title"] = "Profile";
}

<div class="container mt-4">
    <div class="row">

        <!-- LEFT SIDE -->
        <div class="col-md-4">

            <!-- PROFILE CARD -->
            <div class="card p-4 shadow-sm border-0 text-center mb-4">

                @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
                {
                    <img src="@Model.ProfileImagePath"
                         class="rounded-circle mx-auto"
                         style="width:80px;height:80px;object-fit:cover;" />
                }
                else
                {
                    <div class="rounded-circle bg-dark text-white d-flex justify-content-center align-items-center mx-auto"
                         style="width:80px;height:80px;font-size:24px;">
                        @Model.FullName.Substring(0, 1)
                    </div>
                }

                <h5 class="mt-3">@Model.FullName</h5>
                <p class="text-muted">@Model.Email</p>

                <!-- STATS -->
                <div class="d-flex justify-content-around bg-light rounded p-2 mt-3">
                    <div>
                        <strong>@Model.TotalNotes</strong><br />
                        <small>Total</small>
                    </div>
                    <div>
                        <strong>@Model.PublicNotes</strong><br />
                        <small>Public</small>
                    </div>
                    <div>
                        <strong>@Model.PrivateNotes</strong><br />
                        <small>Private</small>
                    </div>
                </div>

                
            </div>

            <!-- EDIT PROFILE -->
            <div class="card p-4 shadow-sm border-0">

                <h6 class="mb-3">Edit profile</h6>

                <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data">

                    <div class="mb-3">
                        <label>Full name</label>
                        <input name="Fullname" class="form-control" value="@Model.FullName" />
                    </div>

                    <div class="mb-3">
                        <label>Email</label>
                        <input name="Email" class="form-control" value="@Model.Email" />
                    </div>

                    <div class="mb-3">
                        <label>Profile photo</label>
                        <input type="file" name="ProfileImage" class="form-control" />
                    </div>

                    <button class="btn btn-primary w-100">
                        Save changes
                    </button>

                </form>
            </div>

        </div>

        <!-- RIGHT SIDE -->
        <div class="col-md-8">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4>
                    All my notes
                    <span class="badge bg-primary">@Model.TotalNotes</span>
                </h4>

                <a asp-controller="Notes" asp-action="Create" class="btn btn-primary btn-sm">
                    + New note
                </a>
            </div>

            <!-- NOTES LIST -->
            @foreach (var note in Model.Notes)
            {
                <div class="card mb-3 shadow-sm border-0 p-3">

                    <div class="d-flex justify-content-between">

                        <div>
                            <h6>@note.Title</h6>

                            <p class="text-muted small mb-1">
                                @(note.Content.Length > 80
                                    ? note.Content.Substring(0, 80) + "..."
                                    : note.Content)
                            </p>

                            <small class="text-muted">
                                @note.CreatedAt.ToString("MMM dd")
                            </small>

                            @if (note.State)
                            {
                                <span class="badge bg-success ms-2">Public</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary ms-2">Private</span>
                            }
                        </div>

                        <div>
                            <a asp-controller="Notes" asp-action="Edit" asp-route-id="@note.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                ✏️
                            </a>

                            <a asp-controller="Notes" asp-action="Delete" asp-route-id="@note.Id"
                                   class="btn btn-sm btn-outline-danger">
                                🗑
                            </a>
                        </div>

                    </div>

                </div>
            }

        </div>
    </div>
</div>